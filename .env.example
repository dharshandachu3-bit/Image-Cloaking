# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# FASTAPI_BACKEND_URL: Base URL of the Python FastAPI + PyTorch cloaking backend.
# Run `uvicorn main:app --host 0.0.0.0 --port 8000` inside /backend for local development.
VITE_API_BASE_URL="http://localhost:8000"

# OPTIONAL: Firebase Authentication configuration (leave empty to use Development Auth Mode).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
